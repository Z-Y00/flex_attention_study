+def _tune_sparse_tiles_on_rocm() -> bool:
+    """Whether to re-tune Triton launch parameters for mask-shrunk tiles.
+
+    The tuning below was measured on gfx942; restrict it to ROCm so other
+    backends keep their existing launch parameters. Making a fine BlockMask
+    lower at all (capping the tiles and re-validating them) is a separate,
+    unconditional fix.
+    """
+    return torch.version.hip is not None
+
+
+def _sparse_fwd_num_warps(default_num_warps: int, block_m: int, block_n: int) -> int:
+    """Forward warp count for a Triton tile that a sparse BlockMask shrank.
+
+    The architecture config is picked for the dense-attention tile. A finer
+    BlockMask leaves the same warp count splitting a much smaller tile, so most
+    lanes idle while the cross-warp reduction is still paid in full. Measured on
+    gfx942 with BF16 and head_dim 128, the forward optimum tracks tile area at
+    roughly one warp per 2048 elements (128x64 -> 4, 64x64 -> 2, 32x32 and
+    16x16 -> 1). Never exceed the config's own warp count.
+    """
+    if not _tune_sparse_tiles_on_rocm():
+        return default_num_warps
+    return max(1, min(default_num_warps, (block_m * block_n) // 2048))
+
+
+def _sparse_bwd_num_warps(default_num_warps: int, *tile_dims: int) -> int:
+    """Backward warp count for tiles that a sparse BlockMask shrank.
+
+    The backward kernel runs a KV-parallel and a Q-parallel pass over tiles of
+    different shapes, so the narrowest dimension across both passes bounds how
+    much parallel work a program actually has. Measured on gfx942 with BF16 and
+    head_dim 128 the optimum is one warp per 16 rows of that narrowest tile
+    (64 -> 4, 32 -> 2, 16 -> 1).
+    """
+    if not _tune_sparse_tiles_on_rocm():
+        return default_num_warps
+    return max(1, min(default_num_warps, min(tile_dims) // 16))
+
+
+def _sparse_bwd_num_stages(default_num_stages: int, *tile_dims: int) -> int:
+    """Backward pipeline depth for tiles that a sparse BlockMask shrank.
+
+    At 32 rows and below a backward tile no longer covers its own global-memory
+    latency, and a second pipeline stage measurably helps on gfx942 (block 16:
+    0.58 ms -> 0.42 ms). At 64 and above the extra stage costs more registers
+    than it recovers, so the config's value stands.
+    """
+    if not _tune_sparse_tiles_on_rocm() or min(tile_dims) > 32:
+        return default_num_stages
+    return max(default_num_stages, 2)
+
